PROJECT_NAME="Jeevika Saarthi AI - Backend API"
API_V1_STR="/api/v1"
SECRET_KEY="jeevika-saarthi-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL + PostGIS Config
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="jeevika_db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg2://postgres:postgres_password@localhost:5432/jeevika_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/jeevika_db"

# Redis Config
REDIS_URL="redis://localhost:6379/0"

# CORS & Security
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=100
ENVIRONMENT="development"
